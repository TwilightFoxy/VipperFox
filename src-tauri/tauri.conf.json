{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VipperFox",
  "version": "0.1.3",
  "identifier": "fox.vipper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "VipperFox",
      "width": 1180,
      "height": 760,
      "minWidth": 900,
      "minHeight": 620,
      "center": true,
      "decorations": false,
      "resizable": true,
      "shadow": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "VipperFox",
    "shortDescription": "Local Twitch VIP companion",
    "longDescription": "Tracks Twitch VIP chat activity and official Watch Streak events locally.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
